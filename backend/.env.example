SPRING_DATASOURCE_URL=jdbc:postgresql://your-database-host:5432/your_database
SPRING_DATASOURCE_USERNAME=your_database_user
SPRING_DATASOURCE_PASSWORD=replace_with_database_password
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_PROFILES_ACTIVE=dev
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
JWT_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
JWT_REFRESH_TOKEN_TTL_SECONDS=604800
ADMIN_USERNAME=replace_with_admin_username
ADMIN_EMAIL=replace_with_admin_email
ADMIN_PASSWORD_HASH=replace_with_bcrypt_password_hash
RESEND_API_KEY=replace_with_resend_api_key
RESEND_FROM_EMAIL=replace_with_verified_sender_email
APP_PUBLIC_URL=http://localhost:3000
