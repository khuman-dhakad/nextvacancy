# NextVacancy Backend Environment Variables

# Spring & Server Configuration
PORT=8080
SERVER_ADDRESS=0.0.0.0
SPRING_PROFILES_ACTIVE=prod
APP_ENVIRONMENT=production

# Database Configuration (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/nextvacancy?sslmode=require
DATABASE_POOL_SIZE=15
DATABASE_POOL_MIN_IDLE=2

# Security & CORS (Comma-separated allowed origins without trailing slashes)
CORS_ALLOWED_ORIGINS=https://nextvacancy.vercel.app
APP_PUBLIC_URL=https://nextvacancy.vercel.app

# Authentication & JWT (Secret must be at least 32 characters / 256 bits)
JWT_SECRET=your-secure-random-256-bit-secret-key-min-32-chars
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
JWT_REFRESH_TOKEN_TTL_SECONDS=604800

# Initial Admin Credentials (password-hash must be a valid BCrypt hash)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@nextvacancy.vercel.app
ADMIN_PASSWORD_HASH=$2a$10$abcdefghijklmnopqrstuvwxyz0123456789

# Transactional Email (Resend API)
RESEND_API_KEY=re_1234567890abcdef
RESEND_FROM_EMAIL=NextVacancy <alerts@nextvacancy.vercel.app>

# Logging
LOG_FILE=/var/log/nextvacancy/api.log
