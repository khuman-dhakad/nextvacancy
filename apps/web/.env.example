# NEXTVACANCY Environment Configuration Template
# Copy this file to .env.local for local development.

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=NextVacancy

# PostgreSQL Database (Drizzle ORM)
# Local development: set a local PostgreSQL URL, for example:
# postgresql://USER:PASSWORD@localhost:5432/nextvacancy
# Preview and production: use the managed PostgreSQL URL for that environment.
DATABASE_URL=
DATABASE_SSL=false
DB_POOL_MAX=10
DB_DEBUG=false

# Community & Social Alert Channels (WhatsApp & Telegram)
NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL=https://whatsapp.com/channel/nextvacancy
NEXT_PUBLIC_TELEGRAM_COMMUNITY_URL=https://t.me/nextvacancy

# Server-only admin authentication. Generate a random session secret (32+ chars)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@nextvacancy.com
ADMIN_PASSWORD_HASH=replace-with-scrypt-password-hash
ADMIN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Server-only candidate session signing secret (32+ random characters)
CANDIDATE_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
