# NEXTVACANCY Environment Configuration Blueprint
# Copy this file to .env.local for local development.

# Application Base URL & Metadata
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=NextVacancy

# Database Configuration (PostgreSQL + Drizzle ORM)
# Local: postgresql://postgres:postgres@localhost:5432/nextvacancy
# Managed (Neon/Supabase/RDS): postgresql://user:password@ep-sample-123.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nextvacancy
DATABASE_SSL=false
DB_POOL_MAX=10
DB_DEBUG=false

# Transactional Email Dispatch (Resend)
# Leave as replace-with-resend-api-key for development console logging
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM=NEXTVACANCY <no-reply@nextvacancy.com>

# Bot Mitigation / Cloudflare Turnstile (Optional in development)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Community & Social Alert Channels (WhatsApp & Telegram)
NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL=https://whatsapp.com/channel/nextvacancy
NEXT_PUBLIC_TELEGRAM_COMMUNITY_URL=https://t.me/nextvacancy

# Admin Authentication Primitives (SHA-256 Hash & Session Secret)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@nextvacancy.com
ADMIN_PASSWORD_HASH=replace-with-sha256-password-hash
ADMIN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
